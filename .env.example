# OpenRouter API key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-...

# Linear API key (Linear > Settings > Security & access > Personal API keys)
LINEAR_API_KEY=lin_api_...

# GitHub personal access token (needs `repo` scope)
GITHUB_API_KEY=ghp_...

# GitHub repo to raise PRs against, e.g. "frankbelk/spec-driven-framework"
GITHUB_REPO=frankbelk/spec-driven-framework

# Optional: override the model used by all agents
# SDD_MODEL=openrouter/nvidia/nemotron-3-super-120b-a12b:free

# Optional: S3 bucket for artifact persistence
# SDD_S3_BUCKET=my-bucket

# Optional: AWS Secrets Manager ARN for production secrets
# SDD_SECRETS_ARN=arn:aws:secretsmanager:eu-west-1:...:secret:...