# Base image for a spec-driven-framework agent (coder/tester/architect/auditor).
FROM python:3.11-slim

WORKDIR /app

# Install system deps needed by crewai/chromadb.
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

# Agents run as a long-lived worker that pulls tasks from a queue.
CMD ["python", "-m", "orchestration.worker"]